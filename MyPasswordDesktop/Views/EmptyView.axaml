<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MyPasswordDesktop.ViewModels"
             x:Class="MyPasswordDesktop.Views.EmptyView"
             x:DataType="vm:EmptyViewModel">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
        <TextBlock Text="&#x1F511;" FontSize="48" HorizontalAlignment="Center" />
        <TextBlock Text="{Binding Hint}" Foreground="Gray" HorizontalAlignment="Center" />
    </StackPanel>
</UserControl>
