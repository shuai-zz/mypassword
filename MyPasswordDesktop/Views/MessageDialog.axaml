<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MyPasswordDesktop.Views.MessageDialog"
        Width="380" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <StackPanel Margin="20" Spacing="18">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button x:Name="OkButton" Content="{DynamicResource common.ok}" Width="90" IsDefault="True" />
            <Button x:Name="CancelButton" Content="{DynamicResource common.cancel}" Width="90" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
