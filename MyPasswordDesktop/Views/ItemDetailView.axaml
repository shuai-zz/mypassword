<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MyPasswordDesktop.ViewModels"
             x:Class="MyPasswordDesktop.Views.ItemDetailView"
             x:DataType="vm:ItemDetailViewModel">
    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="10">

        <!-- action bar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8"
                    IsVisible="{Binding IsActive}">
            <Button Content="{DynamicResource detail.btn.edit}" Command="{Binding EditCommand}" />
        </StackPanel>
        <Separator Grid.Row="1" Margin="0,8" />

        <!-- fields -->
        <ScrollViewer Grid.Row="2">
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DetailRow">
                        <Grid ColumnDefinitions="90,*" Margin="0,5">
                            <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Top" />
                            <Panel Grid.Column="1">
                                <!-- plain text -->
                                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsText}">
                                    <TextBlock Grid.Column="0" Text="{Binding Value}" TextWrapping="Wrap"
                                               VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="{DynamicResource password.btn.copy}"
                                            Command="{Binding CopyCommand}" IsVisible="{Binding CanCopy}"
                                            Padding="8,2" Margin="6,0,0,0" />
                                </Grid>
                                <!-- password -->
                                <Grid ColumnDefinitions="*,Auto,Auto" IsVisible="{Binding IsPassword}">
                                    <TextBlock Grid.Column="0" Text="{Binding Value}" TextWrapping="Wrap"
                                               VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="&#x1F441;"
                                            Command="{Binding ToggleRevealCommand}" Padding="8,2"
                                            Margin="6,0,0,0" />
                                    <Button Grid.Column="2" Content="{DynamicResource password.btn.copy}"
                                            Command="{Binding CopyCommand}" Padding="8,2" Margin="6,0,0,0" />
                                </Grid>
                                <!-- totp -->
                                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsTotp}">
                                    <TextBlock Grid.Column="0" Text="{Binding Value}"
                                               FontFamily="Consolas,Menlo,monospace" FontSize="15"
                                               VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="{DynamicResource password.btn.copy}"
                                            Command="{Binding CopyCommand}" Padding="8,2" Margin="6,0,0,0" />
                                </Grid>
                                <!-- multi -->
                                <ItemsControl ItemsSource="{Binding Values}" IsVisible="{Binding IsMulti}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Panel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- bottom bar -->
        <StackPanel Grid.Row="3" Spacing="8" Margin="0,8,0,0">
            <Separator />
            <TextBlock Text="{Binding LastEdit}" Foreground="Gray" />
            <Button Content="{DynamicResource detail.btn.delete}" Command="{Binding DeleteCommand}"
                    IsVisible="{Binding IsActive}" HorizontalAlignment="Left" />
            <Button Content="{DynamicResource detail.btn.restore}" Command="{Binding RestoreCommand}"
                    IsVisible="{Binding IsDeleted}" HorizontalAlignment="Left" />
        </StackPanel>
    </Grid>
</UserControl>
