<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MyPasswordDesktop.ViewModels"
             xmlns:controls="using:MyPasswordDesktop.Controls"
             x:Class="MyPasswordDesktop.Views.ItemDetailView"
             x:DataType="vm:ItemDetailViewModel">
    <UserControl.Styles>
        <!-- TOTP code turns red in its final seconds (see DetailRow.TotpWarning) -->
        <Style Selector="TextBlock.totpWarn">
            <Setter Property="Foreground" Value="#E04F4F" />
        </Style>
        <!-- text-only button used to render website URLs as hyperlinks -->
        <Style Selector="Button.link">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="#5C8DEF" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.link:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="TextBlock.TextDecorations" Value="Underline" />
        </Style>
    </UserControl.Styles>
    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="10">

        <!-- action bar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8"
                    IsVisible="{Binding IsActive}">
            <Button Content="{DynamicResource detail.btn.edit}" Command="{Binding EditCommand}" />
        </StackPanel>
        <Separator Grid.Row="1" Margin="0,8" />

        <!-- fields -->
        <ScrollViewer Grid.Row="2">
            <ItemsControl ItemsSource="{Binding Rows}" Margin="0,0,16,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DetailRow">
                        <Grid ColumnDefinitions="90,*" Margin="0,5">
                            <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Top" />
                            <Panel Grid.Column="1">
                                <!-- plain text -->
                                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsText}">
                                    <TextBlock Grid.Column="0" Text="{Binding Value}" TextWrapping="Wrap"
                                               VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="{DynamicResource password.btn.copy}"
                                            Command="{Binding CopyCommand}" IsVisible="{Binding CanCopy}"
                                            Padding="8,2" Margin="6,0,0,0" />
                                </Grid>
                                <!-- password -->
                                <Grid ColumnDefinitions="*,Auto,Auto" IsVisible="{Binding IsPassword}">
                                    <TextBlock Grid.Column="0" Text="{Binding Value}" TextWrapping="Wrap"
                                               VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Command="{Binding ToggleRevealCommand}"
                                            Padding="8,2" Margin="6,0,0,0">
                                        <Panel Width="16" Height="16">
                                            <PathIcon Data="{x:Static controls:AppIcons.EyeOpen}"
                                                      Width="16" Height="16"
                                                      IsVisible="{Binding !Revealed}" />
                                            <PathIcon Data="{x:Static controls:AppIcons.EyeClosed}"
                                                      Width="16" Height="16"
                                                      IsVisible="{Binding Revealed}" />
                                        </Panel>
                                    </Button>
                                    <Button Grid.Column="2" Content="{DynamicResource password.btn.copy}"
                                            Command="{Binding CopyCommand}" Padding="8,2" Margin="6,0,0,0" />
                                </Grid>
                                <!-- totp: code + depleting countdown pie + copy -->
                                <Grid ColumnDefinitions="Auto,Auto,*,Auto" IsVisible="{Binding IsTotp}">
                                    <TextBlock Grid.Column="0" Text="{Binding Value}"
                                               Classes.totpWarn="{Binding TotpWarning}"
                                               FontFamily="Consolas,Menlo,monospace" FontSize="15"
                                               VerticalAlignment="Center" />
                                    <Path Grid.Column="1" Width="16" Height="16" Margin="10,0,0,0"
                                          VerticalAlignment="Center" Stretch="None"
                                          Fill="{Binding TotpPieBrush}" Data="{Binding TotpPie}"
                                          ToolTip.Tip="{Binding Label}" />
                                    <Button Grid.Column="3" Content="{DynamicResource password.btn.copy}"
                                            Command="{Binding CopyCommand}" Padding="8,2" Margin="6,0,0,0" />
                                </Grid>
                                <!-- multi -->
                                <ItemsControl ItemsSource="{Binding Values}" IsVisible="{Binding IsMulti}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <!-- websites: list of clickable links -->
                                <ItemsControl ItemsSource="{Binding Values}" IsVisible="{Binding IsWebsites}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Button Classes="link" Content="{Binding}"
                                                    Click="OpenWebsite_Click"
                                                    Margin="0,0,0,6" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Panel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- bottom bar -->
        <StackPanel Grid.Row="3" Spacing="8" Margin="0,8,0,0">
            <Separator Margin="0" />
            <TextBlock Text="{Binding LastEdit}" Foreground="Gray" />
            <Button Content="{DynamicResource detail.btn.delete}" Command="{Binding DeleteCommand}"
                    IsVisible="{Binding IsActive}" HorizontalAlignment="Left" />
            <Button Content="{DynamicResource detail.btn.restore}" Command="{Binding RestoreCommand}"
                    IsVisible="{Binding IsDeleted}" HorizontalAlignment="Left" />
        </StackPanel>
    </Grid>
</UserControl>
