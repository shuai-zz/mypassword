<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MyPasswordDesktop.ViewModels"
             xmlns:controls="using:MyPasswordDesktop.Controls"
             x:Class="MyPasswordDesktop.Views.ItemEditView"
             x:DataType="vm:ItemEditViewModel">
    <Grid RowDefinitions="Auto,Auto,*" Margin="10">

        <!-- action bar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
            <Button Content="{DynamicResource edit.btn.save}" Command="{Binding SaveCommand}" />
            <Button Content="{DynamicResource edit.btn.cancel}" Command="{Binding CancelCommand}" />
        </StackPanel>
        <Separator Grid.Row="1" Margin="0,8" />

        <!-- fields -->
        <ScrollViewer Grid.Row="2">
            <ItemsControl ItemsSource="{Binding Rows}" Margin="0,0,16,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:EditRow">
                        <Grid ColumnDefinitions="90,*" Margin="0,5" IsVisible="{Binding Present}">
                            <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Top"
                                       Margin="0,4,0,0" />
                            <Panel Grid.Column="1">
                                <!-- single line -->
                                <TextBox Text="{Binding Value}" IsVisible="{Binding IsLine}" />
                                <!-- text area -->
                                <TextBox Text="{Binding Value}" IsVisible="{Binding IsArea}"
                                         AcceptsReturn="True" TextWrapping="Wrap" Height="80" />
                                <!-- password -->
                                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsPassword}">
                                    <TextBox Grid.Column="0" Text="{Binding Value}" PasswordChar="&#x2022;"
                                             RevealPassword="{Binding PasswordRevealed, Mode=TwoWay}"
                                             controls:PasswordReveal.Enabled="True" />
                                    <Button Grid.Column="1" Content="{DynamicResource password.gen.btn}"
                                            Margin="6,0,0,0" Command="{Binding GenerateCommand}" />
                                </Grid>
                                <!-- multi values -->
                                <StackPanel IsVisible="{Binding IsMulti}" Spacing="3">
                                    <ItemsControl ItemsSource="{Binding MultiValues}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:MultiEntry">
                                                <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                                    <TextBox Grid.Column="0" Text="{Binding Text}" />
                                                    <Button Grid.Column="1" Content="&#x2715;" Margin="6,0,0,0"
                                                            Command="{Binding RemoveCommand}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Content="{DynamicResource edit.btn.add_more}"
                                            Command="{Binding AddMultiCommand}" HorizontalAlignment="Left" />
                                </StackPanel>
                                <!-- removable info (passkey / totp) -->
                                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsRemovable}">
                                    <TextBlock Grid.Column="0" Text="{Binding Value}" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="&#x2715;" Margin="6,0,0,0"
                                            Command="{Binding RemoveSelfCommand}" />
                                </Grid>
                            </Panel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
