<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MyPasswordDesktop.ViewModels"
             xmlns:controls="using:MyPasswordDesktop.Controls"
             x:Class="MyPasswordDesktop.Views.ItemEditView"
             x:DataType="vm:ItemEditViewModel">
    <Grid RowDefinitions="Auto,Auto,*" Margin="10">

        <!-- action bar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
            <Button Classes="normal" Content="{DynamicResource edit.btn.save}" Command="{Binding SaveCommand}" />
            <Button Classes="normal" Content="{DynamicResource edit.btn.cancel}" Command="{Binding CancelCommand}" />
        </StackPanel>
        <Separator Grid.Row="1" Margin="0,8" />

        <!-- fields -->
        <ScrollViewer Grid.Row="2">
            <ItemsControl ItemsSource="{Binding Rows}" Margin="0,0,16,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:EditRow">
                        <Grid ColumnDefinitions="90,*" Margin="0,5" IsVisible="{Binding Present}">
                            <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Top"
                                       Margin="0,4,0,0" />
                            <Panel Grid.Column="1">
                                <!-- single line -->
                                <TextBox Text="{Binding Value}" IsVisible="{Binding IsLine}" />
                                <!-- text area -->
                                <TextBox Text="{Binding Value}" IsVisible="{Binding IsArea}"
                                         AcceptsReturn="True" TextWrapping="Wrap" Height="80" />
                                <!-- password -->
                                <StackPanel IsVisible="{Binding IsPassword}" Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBox Grid.Column="0" Text="{Binding Value}" PasswordChar="&#x2022;"
                                                 RevealPassword="{Binding PasswordRevealed, Mode=TwoWay}"
                                                 controls:PasswordReveal.Enabled="True" />
                                        <Button Grid.Column="1" Classes="normal"
                                                Margin="6,0,0,0"
                                                Command="{Binding ToggleGeneratorCommand}">
                                            <Panel>
                                                <PathIcon Width="12" Height="12"
                                                          Data="{x:Static controls:AppIcons.CaretUp}"
                                                          IsVisible="{Binding IsGeneratorOpen}" />
                                                <PathIcon Width="12" Height="12"
                                                          Data="{x:Static controls:AppIcons.CaretDown}"
                                                          IsVisible="{Binding !IsGeneratorOpen}" />
                                            </Panel>
                                        </Button>
                                    </Grid>
                                    <Border IsVisible="{Binding IsGeneratorOpen}"
                                            BorderBrush="#CCCCCC" BorderThickness="1"
                                            CornerRadius="4" Padding="8">
                                        <StackPanel Spacing="6">
                                            <!-- Row 1: 4 radios -->
                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                                <RadioButton Content="{DynamicResource password.gen.alpha_num}"
                                                             IsChecked="{Binding IsStyleAlphaNum, Mode=TwoWay}" />
                                                <RadioButton Content="{DynamicResource password.gen.alpha}"
                                                             IsChecked="{Binding IsStyleAlpha, Mode=TwoWay}" />
                                                <RadioButton Content="{DynamicResource password.gen.num}"
                                                             IsChecked="{Binding IsStyleNum, Mode=TwoWay}" />
                                                <RadioButton Content="{DynamicResource password.gen.symbol}"
                                                             IsChecked="{Binding IsStyleAlphaNumSymbol, Mode=TwoWay}" />
                                            </StackPanel>
                                            <!-- Row 2: slider, length, generate -->
                                            <Grid ColumnDefinitions="*,Auto,Auto">
                                                <Slider Grid.Column="0" Minimum="6" Maximum="30"
                                                        Value="{Binding GenLength, Mode=TwoWay}"
                                                        IsSnapToTickEnabled="True" TickFrequency="1"
                                                        VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Width="20" Margin="8,0,0,0"
                                                           Text="{Binding GenLength}"
                                                           TextAlignment="Center"
                                                           VerticalAlignment="Center" />
                                                <Button Grid.Column="2" Classes="normal" Margin="8,0,0,0"
                                                        Content="{DynamicResource password.gen.btn}"
                                                        Command="{Binding GenerateCommand}" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <!-- multi values -->
                                <StackPanel IsVisible="{Binding IsMulti}" Spacing="3">
                                    <ItemsControl ItemsSource="{Binding MultiValues}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:MultiEntry">
                                                <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                                    <TextBox Grid.Column="0" Text="{Binding Text}" />
                                                    <Button Grid.Column="1" Classes="normal" Content="&#x2715;" Margin="6,0,0,0"
                                                            Command="{Binding RemoveCommand}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Classes="normal" Content="{DynamicResource edit.btn.add_more}"
                                            Command="{Binding AddMultiCommand}" HorizontalAlignment="Left" />
                                </StackPanel>
                                <!-- removable info (passkey / totp) -->
                                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsRemovable}">
                                    <TextBlock Grid.Column="0" Text="{Binding Value}" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Classes="normal" Content="&#x2715;" Margin="6,0,0,0"
                                            Command="{Binding RemoveSelfCommand}" />
                                </Grid>
                            </Panel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
