<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MyPasswordDesktop.App"
             xmlns:local="using:MyPasswordDesktop"
             RequestedThemeVariant="Default">

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <!-- Standard app button. White fill with a thin gray rounded border;
             on hover/press fills to gray with white text. -->
        <Style Selector="Button.normal">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="Button.normal /template/ ContentPresenter">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#BBBBBB" />
        </Style>
        <Style Selector="Button.normal:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#808080" />
            <Setter Property="BorderBrush" Value="#808080" />
            <Setter Property="TextBlock.Foreground" Value="White" />
        </Style>
        <Style Selector="Button.normal:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#666666" />
            <Setter Property="BorderBrush" Value="#666666" />
            <Setter Property="TextBlock.Foreground" Value="White" />
        </Style>
        <!-- Borderless, transparent button (used for in-field icon affordances
             such as the password-reveal eye). Suppresses Fluent's default
             hover/pressed background fills so the icon sits flush. -->
        <Style Selector="Button.transparent /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.transparent:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.transparent:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
    </Application.Styles>
</Application>
