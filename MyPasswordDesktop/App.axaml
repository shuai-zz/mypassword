<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MyPasswordDesktop.App"
             xmlns:local="using:MyPasswordDesktop"
             RequestedThemeVariant="Default">

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <!-- Resting-state button colors. The hover/pressed fills (gray with
                 white text) read fine in both variants, but the resting fill was
                 hardcoded white — invisible against light text in dark mode.
                 These per-variant brushes keep the white look in light mode and
                 give a readable dark fill in dark mode. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ButtonRestBackground" Color="White" />
                    <SolidColorBrush x:Key="ButtonRestForeground" Color="#1A1A1A" />
                    <SolidColorBrush x:Key="ButtonRestBorder" Color="#BBBBBB" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="ButtonRestBackground" Color="#333333" />
                    <SolidColorBrush x:Key="ButtonRestForeground" Color="#F0F0F0" />
                    <SolidColorBrush x:Key="ButtonRestBorder" Color="#666666" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <!-- Standard app button. White fill with a thin gray rounded border;
             on hover/press fills to gray with white text. -->
        <Style Selector="Button.normal">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Height" Value="32" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.normal">
            <Setter Property="Foreground" Value="{DynamicResource ButtonRestForeground}" />
        </Style>
        <Style Selector="Button.normal /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ButtonRestBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonRestBorder}" />
        </Style>
        <Style Selector="Button.normal:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#808080" />
            <Setter Property="BorderBrush" Value="#808080" />
            <Setter Property="TextBlock.Foreground" Value="White" />
        </Style>
        <Style Selector="Button.normal:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#666666" />
            <Setter Property="BorderBrush" Value="#666666" />
            <Setter Property="TextBlock.Foreground" Value="White" />
        </Style>
        <!-- Destructive action button. Same shape as .normal but red text /
             border; hover/press fills to red with white text. -->
        <Style Selector="Button.danger">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Foreground" Value="#E04F4F" />
            <Setter Property="Height" Value="32" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.danger /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ButtonRestBackground}" />
            <Setter Property="BorderBrush" Value="#E04F4F" />
        </Style>
        <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#E04F4F" />
            <Setter Property="BorderBrush" Value="#E04F4F" />
            <Setter Property="TextBlock.Foreground" Value="White" />
        </Style>
        <Style Selector="Button.danger:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#B83838" />
            <Setter Property="BorderBrush" Value="#B83838" />
            <Setter Property="TextBlock.Foreground" Value="White" />
        </Style>
        <!-- Borderless, transparent button (used for in-field icon affordances
             such as the password-reveal eye). Suppresses Fluent's default
             hover/pressed background fills so the icon sits flush. -->
        <Style Selector="Button.transparent /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.transparent:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.transparent:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
    </Application.Styles>
</Application>
